rules_version = '2';
// LUCASGOTCHI 친구 편지 — Firebase 콘솔 > Firestore Database > 규칙(Rules)에 붙여넣고 "게시"
service cloud.firestore {
  match /databases/{database}/documents {

    // 친구 코드: 로그인한 사람은 누구나 조회, 내 uid로만 만들고 내 것만 이름 수정
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && code.matches('^[A-HJ-NP-Z2-9]{6}$');
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // 편지: 보낸 사람은 자기 uid로만 보내고(100자 이하), 받는 사람만 읽고 read 표시만 바꿀 수 있음
    match /messages/{id} {
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 100
                    && request.resource.data.read == false;
      allow read: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }
  }
}
